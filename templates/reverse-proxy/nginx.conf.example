# TeaAgent control plane — nginx reverse proxy with per-tenant authZ
#
# Upstream: teaagent control-plane serve --host 127.0.0.1 --port 8765 \
#   --api-token-file /etc/teaagent/tokens.json
#
# Map external identity (e.g. OAuth sub) to tenant + injected bearer token.

upstream teaagent_control_plane {
    server 127.0.0.1:8765;
}

map $http_x_external_user $teaagent_tenant {
    default "";
    "alice" "team-a";
    "bob"   "team-b";
}

map $teaagent_tenant $teaagent_bearer {
    default "";
    "team-a" "TEAM_A_TOKEN_VALUE";
    "team-b" "TEAM_B_TOKEN_VALUE";
}

server {
    listen 443 ssl;
    server_name teaagent.example.com;

    ssl_certificate     /etc/ssl/certs/teaagent.crt;
    ssl_certificate_key /etc/ssl/private/teaagent.key;

    location / {
        if ($teaagent_tenant = "") {
            return 403;
        }
        proxy_set_header Host $host;
        proxy_set_header X-TeaAgent-Tenant $teaagent_tenant;
        proxy_set_header Authorization "Bearer $teaagent_bearer";
        proxy_pass http://teaagent_control_plane;
    }
}

# Vote relay (separate listener)
server {
    listen 4443 ssl;
    server_name relay.teaagent.example.com;

    ssl_certificate     /etc/ssl/certs/teaagent.crt;
    ssl_certificate_key /etc/ssl/private/teaagent.key;
    ssl_client_certificate /etc/ssl/certs/teaagent-client-ca.crt;
    ssl_verify_client on;

    location /api/v1/votes {
        proxy_set_header Authorization "Bearer RELAY_TOKEN_VALUE";
        proxy_pass http://127.0.0.1:8790;
    }
}
